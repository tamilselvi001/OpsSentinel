# OpsSentinel — local development environment template.
# Copy to `.env` (which is git-ignored) and fill in real values for local dev.
# In the cloud, these are injected at runtime by Secret Manager via lib/secrets.get_secret();
# NOTHING here is ever committed with real values.

# ── GCP project (placeholders) ───────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=opssentinel-mvp
GCP_REGION=us-central1

# Force the local env-var fallback even when GOOGLE_CLOUD_PROJECT is set (set to "false"
# on real GCP compute so secrets come from Secret Manager instead).
OPSSENTINEL_USE_SECRET_MANAGER=false

# ── Secrets (Secret Manager names ↔ these env vars; placeholders only) ────────
GEMINI_API_KEY=changeme
ELASTIC_URL=http://localhost:9200
ELASTIC_API_KEY=changeme
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=changeme
SLACK_BOT_TOKEN=xoxb-changeme
SLACK_SIGNING_SECRET=changeme
GOOGLE_OAUTH_CLIENT_ID=changeme.apps.googleusercontent.com
DATABASE_URL=postgresql+psycopg://opssentinel:opssentinel@localhost:5432/opssentinel

# ── Pub/Sub (local emulator mirrors the GCP topology) ────────────────────────
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT_ID=opssentinel-mvp
OPSSENTINEL_ALERTS_TOPIC=opssentinel-alerts
OPSSENTINEL_ALERTS_SUB=opssentinel-alerts-sub
OPSSENTINEL_ALERTS_DLQ=opssentinel-alerts-dlq
OPSSENTINEL_ACTIONS_TOPIC=opssentinel-actions
